# Optional. When set, the KREKU assistant answers via the Gemini API
# (Google AI Studio key, streaming, gemini-flash-lite-latest). When absent, it falls
# back to the built-in offline engine — the app works fully without it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Backs the /api/chat and /api/weather rate limiters with Redis so limits
# hold across serverless instances. Without these, rate limiting falls back
# to an in-memory, per-instance counter (dev-only protection, does not stop
# an attacker fanning requests out across concurrent instances). Provisioned
# automatically as KV_REST_API_URL/TOKEN via `vercel integration add
# upstash/upstash-kv` (Vercel Marketplace); UPSTASH_REDIS_REST_URL/TOKEN also
# works if you're using a raw Upstash account instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
